{
  "$schema": "https://demotime.show/schema.json",
  "title": "Closing — 'which would you try first?'",
  "description": "Single-select poll with delta-vs-opener overlay; bridges into the decision guide.",
  "demos": [
    {
      "title": "Start the closing poll (QR + question appear; ghost bars from opener overlay)",
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "engageTime.startPoll",
          "args": { "pollId": "closing-pick" }
        }
      ]
    },
    {
      "title": "Wait for audience answers (~60s)",
      "steps": [
        {
          "action": "waitForInput",
          "message": "Audience answering — read deltas aloud once bars stabilize"
        }
      ]
    },
    {
      "title": "Stop the poll (results stay frozen for the decision-guide narration)",
      "steps": [
        { "action": "executeVSCodeCommand", "command": "engageTime.stopPoll" }
      ]
    },
    {
      "title": "Advance to the decision guide slide",
      "steps": [
        { "action": "openSlide", "path": "slides/07-decision-guide/00-decision-guide.md" }
      ]
    }
  ]
}
