{
  "$schema": "https://demotime.show/schema.json",
  "title": "Opening — audience familiarity poll",
  "description": "DemoTime drives the EngageTime opening poll start/stop so Marc only operates one extension on stage.",
  "demos": [
    {
      "title": "Show 'The 5 contenders' slide (poll question matches the option list)",
      "steps": [
        { "action": "openSlide", "path": "slides/00-open/03-five-contenders.md" }
      ]
    },
    {
      "title": "Start the opening poll (QR + bar chart appear on the projector)",
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "engageTime.startPoll",
          "args": { "pollId": "opening-familiarity" }
        }
      ]
    },
    {
      "title": "Wait for audience answers (~60–90s) — advance manually",
      "steps": [
        {
          "action": "waitForInput",
          "message": "Audience answering — read the room aloud, advance when bars stabilize"
        }
      ]
    },
    {
      "title": "Stop the poll (results stay frozen on screen for one beat)",
      "steps": [
        { "action": "executeVSCodeCommand", "command": "engageTime.stopPoll" }
      ]
    },
    {
      "title": "Advance to the lineage map slide",
      "steps": [
        { "action": "openSlide", "path": "slides/00-open/05-lineage-map.md" }
      ]
    }
  ]
}
